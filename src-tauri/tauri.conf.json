{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "THE BEST MARKETPLACE PREMIUM",
  "version": "1.0.0",
  "identifier": "br.com.thebestdigital.marketplacepremium",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "THE BEST MARKETPLACE PREMIUM",
        "width": 1,
        "height": 1,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}